# AgroGuide Backend Environment Configuration

# Database
DATABASE_URL=sqlite:///./agroguide.db

# Security
SECRET_KEY=agroguide_secret_super_key_2026_change_in_production_jwt99
ADMIN_SECRET_KEY=AGROGUIDE_ADMIN_2026_SECRET

# SMTP Email Configuration (For sending REAL OTP codes directly to user emails)
# For Gmail: Use smtp.gmail.com with port 587 and generate a Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=no-reply@agroguide.com
SMTP_FROM_NAME=AgroGuide Platform
