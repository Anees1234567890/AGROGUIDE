# AgroGuide Backend Environment Variables
APP_NAME=AgroGuide
APP_ENV=development
PORT=8000
DEBUG=true

# Database Configuration
# Default to SQLite for immediate zero-config execution:
DATABASE_URL=sqlite:///./agroguide.db
# Or use MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agroguide

# Authentication & Security
SECRET_KEY=agroguide_secret_super_key_2026_change_in_production_jwt99
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode & External Services (true enables rich offline fallback simulation)
DEMO_MODE=true

# External APIs (Optional - system falls back gracefully if not provided)
WEATHER_API_KEY=
AI_API_KEY=
AI_PROVIDER=gemini
